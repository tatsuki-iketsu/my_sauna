---
interface ItemObject {
  label?: string;
  text: string;
}

export type ChecklistItem = string | ItemObject;

interface Props {
  title?: string;
  items?: ChecklistItem[];
}

const { title, items = [] } = Astro.props;
---

<div style="background: #fffdfa; border: 2.5px solid #2b221a; border-radius: 8px; padding: 20px 24px; margin: 28px 0; box-shadow: 4px 4px 0 rgba(43, 34, 26, 0.15);">
  {title && (
    <div style="font-size: 1.15rem; font-weight: bold; color: #2b221a; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 2px dashed #cfc2ab; display: flex; align-items: center; gap: 8px;">
      <span>📋</span>
      <span>{title}</span>
    </div>
  )}
  {items.length > 0 ? (
    <ul style="list-style: none; padding: 0; margin: 0;">
      {items.map((item, index) => {
        const isLast = index === items.length - 1;
        const marginBottom = isLast ? '0' : '14px';
        const isObj = typeof item === 'object' && item !== null;
        const label = isObj ? item.label : undefined;
        const text = isObj ? item.text : item;

        return (
          <li style={`display: flex; align-items: flex-start; margin-bottom: ${marginBottom};`}>
            <span style="font-size: 24px; line-height: 1; margin-right: 12px; color: #2b221a; flex-shrink: 0;">□</span>
            <div>
              {label ? (
                <>
                  <strong>{label}</strong>: {text}
                </>
              ) : (
                <span>{text}</span>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <slot />
  )}
</div>
