const description = '家庭用サウナに必要な「20A専用回路工事」の全貌を電気のプロが解説。一般15Aコンセントの危険性、分電盤の空きスロット確認、工事費用相場（2万〜5万円）、施工時間、電気工事店への発注テンプレートと熱波 スタンダートの導入手順を網羅。';
const slug = '20a-circuit-electrical-work';
const kicker = '安全に使うための20A専用回路工事ガイド';

const relatedArticles = [{'slug': 'washroom-dressing-room-layout', 'title': '洗面脱衣所にサウナを置く！水風呂直行の動線作りと湿気・寸法の注意点', 'badge': '水風呂直行！脱衣所サウナの理想動線'}, {'slug': 'electricity-cost-per-session', 'title': '家庭用サウナの電気代は1回いくら？毎日使った場合の月額コストを徹底試算', 'badge': '1回・月額・年間のリアルな電気代試算'}, {'slug': 'floor-load-bearing-capacity', 'title': '家庭用サウナの重さで床は抜けない？床耐荷重の基準と補強工事の要否', 'badge': '床耐荷重の基準と安心の設置チェック'}, {'slug': 'second-floor-installation', 'title': '木造戸建ての2階にサウナは置ける？搬入経路・重量・水漏れ対策のチェック', 'badge': '木造2階への設置チェックポイント'}];
