const relatedArticles = [{'slug': 'diy-sauna-dangers', 'title': '自宅サウナをDIYで自作するリスク｜断熱不足・火災・電気事故の危険性', 'badge': '自宅サウナ DIY 自作 リスク'}, {'slug': 'sauna-umbrella-ineffective', 'title': 'お風呂のサウナ傘は「効果ない」？口コミ検証と本格サウナとの圧倒的な違い', 'badge': 'お風呂サウナ 傘 効果 ない'}, {'slug': 'mist-sauna-vs-dry-sauna', 'title': '浴室ミストサウナ後付け vs 独立型ドライサウナ｜費用・温まり・リフレッシュ感を比較', 'badge': '家庭用ミストサウナ 後付け 比較'}, {'slug': 'portable-steam-sauna-review', 'title': 'ポータブル家庭用スチームサウナの使い勝手と耐久性｜格安ビニール型のリアル', 'badge': 'スチームサウナ 家庭用 ポータブル'}];
