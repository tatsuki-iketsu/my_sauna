const description = '100V電源で本格ロウリュができる家庭用サウナの条件を徹底解説。漏電やヒーター故障を防ぐストーブ構造、20A専用回路工事の必要性、熱波 スタンダートの対応状況と安全基準を整理します。';
const eyecatch = '/images/articles/100v-loyly.jpg';
