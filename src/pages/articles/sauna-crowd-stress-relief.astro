const title = 'サウナの混雑・待ち時間ストレスから解放されたい！自宅サウナがもたらす心の平穏';
const description = 'サウナの混雑・待ち時間ストレスから解放されたい！自宅サウナがもたらす心の平穏について、仕様・設置条件・注意点を専門的に解説します。';
const slug = 'sauna-crowd-stress-relief';
const kicker = 'サウナ 混雑 ストレス 自宅サウナ';

