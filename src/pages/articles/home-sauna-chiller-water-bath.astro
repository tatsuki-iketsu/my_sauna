const relatedArticles = [{'slug': 'portable-steam-sauna-review', 'title': 'ポータブル家庭用スチームサウナの使い勝手と耐久性｜格安ビニール型のリアル', 'badge': 'ポータブルスチームサウナの使い勝手と耐久性'}, {'slug': 'custom-home-sauna-plan', 'title': 'サウナ付き住宅を建てる前に！造作サウナ（数百万円）より後付けサウナがおすすめな理由', 'badge': '新築・リフォーム時の造作サウナ vs 後付け比較'}, {'slug': 'totonoi-space-and-flow', 'title': '自宅サウナの完璧なレイアウト動線｜サウナ・水風呂・ととのい椅子の配置術', 'badge': '最高のととのいを作る黄金レイアウト動線'}, {'slug': 'sauna-aroma-essential-oil', 'title': '自宅サウナで楽しむロウリュ用アロマの選び方｜白樺・ユーカリ・柑橘の安全な使い方', 'badge': '白樺やハーブが香るロウリュ用アロマの選び方'}];
