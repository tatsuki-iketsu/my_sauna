<ArticleLayout
  title={title}
  description={description}
  kicker="全50記事・完全攻略アーカイブ"
  slug="index"
>
  <div class="archive-header" style="margin-bottom: 30px;">
    <p style="font-size: 16px; color: #4a3b2c; line-height: 1.8;">
      自宅サウナを検討中の皆様に向けて、電気仕様（100V/200V）、マンション・脱衣所への設置、ロウリュ対応、費用相場、ととのい空間づくりまで、気になる疑問を徹底的に網羅した全50記事の解説ガイドです。
    </p>
  </div>

  <div class="articles-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 30px;">
    {articles.map((item, index) => (
      <a href={'/articles/' + item.slug + '/'} style="background: #fffdfa; border: 2px solid #2b221a; border-radius: 8px; padding: 18px; box-shadow: 3px 4px 0 rgba(43, 34, 26, 0.15); display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; color: inherit; transition: transform 0.15s, background 0.15s;">
        <div>
          <span style="display: inline-block; font-size: 11.5px; font-weight: 700; color: #538558; background: #e0eee0; padding: 2px 8px; border-radius: 4px; margin-bottom: 8px;">
            #{String(index + 1).padStart(2, '0')} {item.keyword}
          </span>
          <h3 style="font-size: 16px; font-family: 'Zen Maru Gothic', sans-serif; font-weight: 700; margin: 0 0 10px; color: #6e4726; border: none; padding: 0; line-height: 1.5;">
            {item.title}
          </h3>
          <p style="font-size: 13px; color: #6e5e4e; line-height: 1.6; margin: 0;">
            {item.description.slice(0, 75)}...
          </p>
        </div>
        <div style="margin-top: 14px; font-size: 12.5px; font-weight: 700; color: #3ea5bc; text-align: right;">
          記事を読む →
        </div>
      </a>
    ))}
  </div>
</ArticleLayout>
