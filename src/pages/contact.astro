---
// src/pages/contact.astro
const title = "お問い合わせ｜おうちサウナのある暮らし";
const description = "「おうちサウナのある暮らし」へのお問い合わせページです。家庭用サウナに関するご質問・ご相談、記事へのご感想や掲載情報に関するお問い合わせなど、こちらのフォームよりお気軽にお寄せください。";
const formUrl = "https://docs.google.com/forms/d/e/1FAIpQLSfS9kZNlwyMt8UKL-EumFHPwy4F9kPhFURt09RkTmLxwQBUBg/viewform";
const formEmbedUrl = "https://docs.google.com/forms/d/e/1FAIpQLSfS9kZNlwyMt8UKL-EumFHPwy4F9kPhFURt09RkTmLxwQBUBg/viewform?embedded=true";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Yomogi&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PM1NEGC92N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PM1NEGC92N');
    </script>
    <style is:global>
      :root {
        --ink: #2b221a;
        --wood-frame: #633e20;
        --wood-frame-border: 4.5px solid var(--wood-frame);
        --wood-frame-shadow: 6px 7px 0 rgba(43, 34, 26, 0.95);
        --wood: #a67c52;
        --wood-dark: #6e4726;
        --wood-light: #ebdcc8;
        --yellow: #f5c738;
        --yellow-hover: #e6b726;
        --yellow-soft: #faeab1;
        --water: #3ea5bc;
        --water-light: #daf0f4;
        --leaf: #538558;
        --leaf-light: #e0eee0;
        --line: 2px solid var(--ink);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      
      body {
        margin: 0;
        color: var(--ink);
        background-color: #f7efe1;
        background-image: 
          linear-gradient(rgba(252, 248, 240, 0.82), rgba(248, 238, 222, 0.82)),
          url('/images/bg_wood.jpg');
        background-repeat: repeat;
        background-size: 800px auto;
        background-attachment: fixed;
        font-family: "Zen Maru Gothic", sans-serif;
        font-size: 16px;
        line-height: 1.85;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .top-note {
        background: #eadecc;
        color: #554433;
        font-size: 11.5px;
        text-align: center;
        padding: 5px 12px;
        border-bottom: 1.5px dashed #bba893;
        font-family: "Zen Maru Gothic", sans-serif;
      }

      /* 共通ヘッダー */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(252, 248, 240, 0.96);
        backdrop-filter: blur(6px);
        border-bottom: var(--line);
        box-shadow: 0 4px 0 rgba(43, 34, 26, 0.08);
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 100%;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "Yomogi", cursive;
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
      }
      .logo-mark {
        width: 38px;
        height: 34px;
        border-radius: 6px 10px 8px 12px;
        background: var(--yellow);
        color: var(--ink);
        border: var(--line);
        display: grid;
        place-items: center;
        font-size: 13px;
        box-shadow: 2px 2px 0 var(--ink);
      }
      .logo small {
        display: block;
        font-size: 11px;
        color: #635547;
        font-family: "Zen Maru Gothic", sans-serif;
      }

      .main-nav {
        display: flex;
        gap: 18px;
        align-items: center;
        font-size: 14px;
        font-weight: 700;
      }
      .main-nav a {
        padding: 4px 8px;
        border-bottom: 2px solid transparent;
        transition: border-color .2s;
      }
      .main-nav a:hover {
        border-bottom-color: var(--water);
      }

      .menu-toggle {
        display: none;
        background: #fff;
        border: var(--line);
        border-radius: 6px;
        padding: 6px 12px;
        font-family: "Yomogi", cursive;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 2px 2px 0 var(--ink);
      }

      @media (max-width: 768px) {
        .menu-toggle { display: block; }
        .main-nav {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: #fffdfa;
          flex-direction: column;
          padding: 16px;
          border-bottom: var(--line);
          box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .main-nav.is-active { display: flex; }
      }

      /* コンテナ */
      .container {
        width: min(840px, calc(100% - 32px));
        margin: 32px auto 60px;
      }

      /* パンくずリスト */
      .breadcrumb {
        font-size: 13px;
        color: #6e5e4e;
        margin-bottom: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
      }
      .breadcrumb a {
        text-decoration: underline;
      }

      /* ページ見出し */
      .page-header {
        text-align: center;
        margin-bottom: 36px;
      }
      .page-kicker {
        display: inline-block;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--wood-dark);
        background: var(--wood-light);
        padding: 4px 14px;
        border-radius: 20px;
        border: 1.5px solid var(--wood-dark);
        margin-bottom: 12px;
      }
      .page-title {
        font-family: "Yomogi", cursive;
        font-size: clamp(26px, 4vw, 34px);
        margin: 0 0 12px;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }
      .page-lead {
        font-size: 15px;
        color: #554433;
        line-height: 1.8;
        max-width: 680px;
        margin: 0 auto;
      }

      /* 注意事項・案内カード（コルクボード風） */
      .notice-board {
        background: #fffdfa;
        border: var(--wood-frame-border);
        box-shadow: var(--wood-frame-shadow);
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 32px;
        position: relative;
      }
      .notice-board-title {
        font-family: "Yomogi", cursive;
        font-size: 19px;
        font-weight: 700;
        color: var(--wood-dark);
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 2px dashed var(--wood-light);
        padding-bottom: 8px;
      }
      .notice-list {
        margin: 0;
        padding-left: 20px;
        font-size: 14.5px;
        color: #4a3b2c;
      }
      .notice-list li {
        margin-bottom: 8px;
      }

      /* フォームカード */
      .form-container {
        background: #fffdfa;
        border: var(--line);
        box-shadow: 4px 5px 0 rgba(43, 34, 26, 0.2);
        border-radius: 12px;
        padding: 12px 10px;
        margin-bottom: 32px;
        overflow: hidden;
      }
      .form-iframe {
        width: 100%;
        height: 860px;
        border: none;
        display: block;
      }

      /* 直接開くボタンエリア */
      .fallback-area {
        background: #fff9ee;
        border: 2px dashed var(--wood);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        margin-top: 24px;
      }
      .fallback-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--yellow);
        color: var(--ink);
        border: var(--line);
        box-shadow: 3px 3px 0 var(--ink);
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 15px;
        font-family: "Zen Maru Gothic", sans-serif;
        margin-top: 10px;
        transition: all .15s;
        cursor: pointer;
      }
      .fallback-btn:hover {
        background: var(--yellow-hover);
        transform: translate(1px, 1px);
        box-shadow: 2px 2px 0 var(--ink);
      }

      /* 共通フッター */
      .site-footer {
        background: #eadecc;
        border-top: var(--line);
        padding: 32px 20px;
        margin-top: 60px;
      }
      .footer-inner {
        width: min(900px, 100%);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-items: center;
        text-align: center;
      }
      @media (min-width: 600px) {
        .footer-inner {
          flex-direction: row;
          justify-content: space-between;
          text-align: left;
        }
      }
      .footer-links {
        margin-top: 8px;
        display: flex;
        gap: 16px;
        font-size: 13px;
      }
      .footer-links a {
        color: var(--wood-dark);
        text-decoration: underline;
        font-weight: 700;
      }
      .footer-links a:hover {
        color: var(--water);
      }
    </style>
  </head>
  <body>
    <div class="top-note">
      ※本記事および当サイトにはアフィリエイト広告およびプロモーションが含まれています。中立な仕様・安全基準に基づいて客観的に情報を整理しています。
    </div>

    <!-- 共通ヘッダー（ヘッダーリンクはお問い合わせを含めず既存のまま維持） -->
    <header class="site-header">
      <a href="/" class="logo">
        <span class="logo-mark">♨</span>
        <div>
          おうちサウナのある暮らし
          <small>自宅サウナの費用・設置条件ガイド</small>
        </div>
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="メニュー開閉">メニュー</button>
      <nav class="main-nav" id="mainNav">
        <a href="/">トップ</a>
        <a href="/articles/">記事一覧</a>
        <a href="/sauna/neppa-standard/">熱波 スタンダート</a>
      </nav>
    </header>

    <div class="container">
      <!-- パンくずリスト -->
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">トップ</a>
        <span>&gt;</span>
        <span>お問い合わせ</span>
      </nav>

      <main>
        <header class="page-header">
          <div class="page-kicker">CONTACT FORM</div>
          <h1 class="page-title">
            <span>♨</span>
            <span>お問い合わせ</span>
          </h1>
          <p class="page-lead">
            当サイト「おうちサウナのある暮らし」をご覧いただきありがとうございます。<br />
            家庭用サウナの導入に関するご質問、記事内容へのご感想・ご指摘、情報提供やお仕事のご相談などがございましたら、下記の専用フォームよりお気軽にお問い合わせください。
          </p>
        </header>

        <!-- ご案内・注意事項 -->
        <section class="notice-board">
          <h2 class="notice-board-title">
            <span>📋</span>
            <span>お問い合わせいただく前のご案内</span>
          </h2>
          <ul class="notice-list">
            <li>
              <strong>入力項目について</strong>：お名前（ニックネーム・ハンドルネーム可）、ご連絡先（メールアドレスやSNSアカウント等）、お問い合わせ内容をご記入いただけます。
            </li>
            <li>
              <strong>回答の目安</strong>：いただいた内容は確認の上、原則3〜5営業日以内にご連絡差し上げます（内容や状況によってはお返事までにお時間をいただく場合や、ご返信いたしかねる場合がございます）。
            </li>
            <li>
              <strong>個人情報の取り扱い</strong>：ご入力いただいた情報は、お問い合わせ内容への回答および確認の目的にのみ使用し、第三者に無断で提供・開示することは一切ございません。
            </li>
          </ul>
        </section>

        <!-- Googleフォーム埋め込みエリア -->
        <section class="form-container">
          <iframe
            class="form-iframe"
            src={formEmbedUrl}
            title="おうちサウナのある暮らし お問い合わせフォーム"
            loading="lazy"
          >
            読み込み中…
          </iframe>
        </section>

        <!-- フォームが開かない場合のフォールバック案内 -->
        <div class="fallback-area">
          <p style="margin: 0 0 6px; font-size: 14px; color: #554433;">
            ※お使いのブラウザやセキュリティ設定により上記のフォームが表示されない場合は、以下のボタンよりGoogleフォームを直接開いてご送信ください。
          </p>
          <a
            href={formUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="fallback-btn"
          >
            <span>👉</span>
            <span>Googleフォームを新しいタブで開く</span>
          </a>
        </div>
      </main>
    </div>

    <!-- 共通フッター -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong style="font-family: 'Yomogi', cursive; font-size: 17px; color: var(--ink);">おうちサウナのある暮らし</strong>
          <p style="font-size: 12.5px; color: #635547; margin: 4px 0 0;">家庭用サウナの費用・設置条件・注意点を中立に整理するガイドサイト</p>
          <div class="footer-links">
            <a href="/">トップページ</a>
            <a href="/articles/">記事一覧</a>
            <a href="/contact/">お問い合わせ</a>
          </div>
        </div>
        <p style="font-size: 11.5px; color: #635547; margin: 0;">© 2026 おうちサウナのある暮らし All Rights Reserved.</p>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('menuToggle');
      const mainNav = document.getElementById('mainNav');
      if (menuBtn && mainNav) {
        menuBtn.addEventListener('click', () => {
          mainNav.classList.toggle('is-active');
        });
      }
    </script>
  </body>
</html>
