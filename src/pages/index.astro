    <script>
      // スマホ用ナビゲーション開閉スクリプト
      const menuBtn = document.getElementById('menuToggle');
      const mainNav = document.getElementById('mainNav');
      if (menuBtn && mainNav) {
        menuBtn.addEventListener('click', () => {
          mainNav.classList.toggle('is-active');
        });
        // リンククリックでメニューを閉じる
        mainNav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            mainNav.classList.remove('is-active');
          });
        });
      }

      // TOP画像ランダム表示スクリプト（直前に表示したイラスト以外を選択）
      (function() {
        const topImages = [
          'images/TOP/hero-sauna-family-closeup-sauna.png',
          'images/TOP/hero-sauna-female-friends-angle.png',
          'images/TOP/hero-sauna-male-friends-angle.png',
          'images/TOP/hero-sauna-man-angle.png',
          'images/TOP/hero-sauna-variant-a.png',
          'images/TOP/hero-sauna-variant-c.png',
          'images/TOP/hero-sauna-woman-angle.png'
        ];

        const lastImg = localStorage.getItem('lastTopSaunaImage');
        // 直前画像を除外した候補配列を作成
        const availableImages = topImages.filter(img => img !== lastImg);
        // 候補からランダムに1枚選択（万一全除外なら全体から）
        const pool = availableImages.length > 0 ? availableImages : topImages;
        const selectedImg = pool[Math.floor(Math.random() * pool.length)];

        // localStorageに今回表示した画像を保存
        localStorage.setItem('lastTopSaunaImage', selectedImg);

        // 画像要素に反映
        const imgEl = document.getElementById('heroRandomImg');
        if (imgEl) {
          imgEl.src = selectedImg;
        }
      })();
    </script>
