<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="室内用の家庭用サウナを、住まいの条件・予算・手入れから検討するガイド。熱波 スタンダートを中心に、30～50万円の候補や浴槽用品との違いを整理します。"
    />
    <meta name="google-site-verification" content="ZqPI0cCzNq6camzxA4B4qL-dlmMyxAkKnPzOtulywIU" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PM1NEGC92N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PM1NEGC92N');
    </script>
    <title>室内に家庭用サウナを置くには？賃貸・戸建ての設置条件と選び方｜おうちサウナのある暮らし</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Yomogi&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        /* 手書き風カラーパレット：サウナテーマ */
        --ink: #2b221a;              /* 墨色・ダークウッドブラウン */
        
        /* 🪵 重厚な木枠（ウッドフレーム）パレット */
        --wood-frame: #633e20;       /* コルクボードに合う深みのある木枠色 */
        --wood-frame-border: 4.5px solid var(--wood-frame); /* しっかり太い木枠線 */
        --wood-frame-shadow: 6px 7px 0 rgba(43, 34, 26, 0.95); /* 手書き風のしっかりした黒影 */
        
        --wood: #a67c52;             /* サウナの木材カラー（アクセント木目） */
        --wood-dark: #6e4726;        /* 濃い木材・ヒノキ・ウォールナット */
        --wood-light: #ebdcc8;       /* 柔らかな木板カラー */
        
        /* 役割分担ルール：
           ★ボタン・主要アクション：サウナマット黄色（--yellow）で統一
           ★下線・アクセント装飾：水風呂水色（--water）で統一
           ★アイコン・自然アクセント：葉っぱ緑（--leaf） */
        --yellow: #f5c738;           /* サウナマットのイエロー（ボタン・重要タグ） */
        --yellow-hover: #e6b726;     /* ボタンホバー時 */
        --yellow-soft: #faeab1;      /* 優しいサウナマット黄色 */
        
        --water: #3ea5bc;            /* 水風呂のクリアな水色（見出し下線・アクセントライン） */
        --water-light: #daf0f4;      /* 水風呂の淡い水色 */
        
        --leaf: #538558;             /* ヴィヒタ・葉っぱのグリーン（チェックマーク・バッジ） */
        --leaf-light: #e0eee0;       /* 若葉のペールグリーン */
        
        --line: 2px solid var(--ink);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      
      /* 🌲 1枚目の木目画像を少し薄く透過させたサイト全体の背景 */
      body {
        margin: 0;
        color: var(--ink);
        background-color: #f7efe1; /* ベースの下地色 */
        background-image: 
          linear-gradient(rgba(252, 248, 240, 0.82), rgba(248, 238, 222, 0.82)),
          url('/images/bg_wood.jpg');
        background-repeat: repeat;
        background-size: 800px auto;
        background-attachment: fixed;
        font-family: "Zen Maru Gothic", sans-serif;
        font-size: 16px;
        line-height: 1.85;
      }
      a { color: inherit; text-decoration: none; }

      .top-note {
        padding: 6px 20px;
        text-align: right;
        font-size: 11px;
        letter-spacing: .05em;
        color: #726457;
        background: rgba(243, 235, 217, 0.92);
        border-bottom: 1px dashed #cfc2ab;
      }

      /* ヘッダー */
      .site-header {
        width: min(1160px, calc(100% - 32px));
        min-height: 80px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: var(--line);
        position: relative;
        background: rgba(252, 248, 240, 0.6);
        backdrop-filter: blur(2px);
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "Yomogi", cursive;
        font-size: 18px;
        line-height: 1.15;
        font-weight: 700;
      }
      .logo-mark {
        width: 40px;
        height: 36px;
        display: grid;
        place-items: center;
        color: var(--ink);
        background: var(--yellow);
        border: 2px solid var(--ink);
        border-radius: 48% 52% 44% 56% / 54% 48% 52% 46%;
        font: 700 13px "DM Mono", monospace;
        transform: rotate(-4deg);
        box-shadow: 2px 2px 0 var(--wood-dark);
        flex-shrink: 0;
      }
      .logo span small {
        font-size: 11px;
        color: var(--leaf);
        display: block;
        font-family: "Zen Maru Gothic", sans-serif;
        font-weight: normal;
      }

      /* ハンバーガーメニューボタン */
      .menu-toggle {
        display: none;
        background: none;
        border: var(--line);
        border-radius: 6px;
        padding: 6px 10px;
        cursor: pointer;
        font-family: "Yomogi", cursive;
        font-size: 13px;
        color: var(--ink);
        background: #fdfaf3;
        box-shadow: 2px 2px 0 var(--ink);
      }

      .main-nav {
        display: flex;
        gap: 22px;
        font-family: "Yomogi", cursive;
        font-size: 16px;
      }
      .main-nav a {
        position: relative;
        padding-bottom: 4px;
        transition: color .2s;
      }
      .main-nav a:hover {
        color: var(--wood-dark);
        border-bottom: 3px solid var(--water); /* 下線は水色 */
      }

      /* ヒーローセクション */
      .hero {
        width: min(1160px, calc(100% - 32px));
        margin: 0 auto;
        min-height: 540px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 32px;
        align-items: center;
        padding: 36px 0 50px;
      }
      .eyebrow {
        margin: 0 0 12px;
        font: 13px "DM Mono", monospace;
        letter-spacing: .08em;
        color: var(--wood-dark);
      }
      .eyebrow span {
        width: 24px;
        display: inline-block;
        border-top: 3px solid var(--water); /* 下線・ボーダーは水色 */
        vertical-align: middle;
        margin-right: 8px;
      }
      h1 {
        margin-top: 0;
        margin-bottom: 18px;
        font-family: "Yomogi", cursive;
        font-size: clamp(34px, 5.2vw, 64px);
        line-height: 1.3;
        letter-spacing: -.03em;
      }
      h1 em {
        color: var(--wood-dark);
        font-style: normal;
        border-bottom: 4px solid var(--water); /* 下線は水色 */
      }
      h1 .water-txt {
        color: var(--water);
        font-style: normal;
      }
      .hero-text {
        margin-bottom: 26px;
        font-size: 16px;
        line-height: 1.85;
        color: #40342a;
      }

      /* ★ボタンはサウナマット黄色で統一★ */
      .button-group {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 22px;
        border: var(--line);
        border-radius: 6px 10px 7px 11px;
        font-family: "Yomogi", cursive;
        font-size: 17px;
        line-height: 1.3;
        background: var(--yellow); /* すべてのボタンを黄色で統一 */
        color: var(--ink);
        box-shadow: 3px 3px 0 var(--ink);
        transition: transform .18s, box-shadow .18s, background .18s;
        cursor: pointer;
        text-align: center;
      }
      .button:hover {
        transform: translate(1px, 1px);
        box-shadow: 2px 2px 0 var(--ink);
        background: var(--yellow-hover);
      }

      /* ヒーローのトップ画像フレーム */
      .hero-illustration {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .hero-frame-box {
        position: relative;
        width: 100%;
        max-width: 480px;
        background: #fffdf8;
        border: var(--wood-frame-border);
        border-radius: 14px 16px 13px 15px;
        padding: 12px;
        box-shadow: 
          inset 0 0 0 2px rgba(255, 245, 230, 0.7),
          var(--wood-frame-shadow);
        transform: rotate(1deg);
        transition: transform 0.3s ease;
      }
      .hero-frame-box:hover {
        transform: rotate(0deg) scale(1.01);
      }
      .hero-img-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid var(--ink);
        background: #f4ecdf;
      }
      .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: opacity 0.35s ease-in-out;
      }

      /* 付箋メモ */
      .memo {
        position: absolute;
        padding: 10px 14px;
        border: 2px solid var(--ink);
        font: 14px/1.3 "Yomogi", cursive;
        box-shadow: 3px 3px 0 rgba(44,36,30,.8);
        border-radius: 4px 7px 5px 6px;
        z-index: 2;
      }
      .memo-yellow {
        top: 15px;
        right: 15px;
        background: var(--yellow-soft);
        transform: rotate(6deg);
      }
      .memo-water {
        bottom: 20px;
        left: 10px;
        background: var(--water-light);
        transform: rotate(-5deg);
        color: #176476;
      }
      .memo-leaf {
        top: 20px;
        left: 15px;
        background: var(--leaf-light);
        transform: rotate(-7deg);
        color: #235429;
      }

      /* 共通セクション */
      .section-wrap {
        width: min(1160px, calc(100% - 32px));
        margin: 0 auto;
        padding: 55px 0;
      }
      .section-heading {
        margin-bottom: 28px;
        text-align: center;
      }
      .section-kicker {
        font: 12px "DM Mono", monospace;
        letter-spacing: .12em;
        color: var(--leaf);
        margin-bottom: 6px;
        font-weight: 700;
      }
      .section-heading h2 {
        margin: 0 0 8px;
        font: clamp(26px, 3.8vw, 40px) "Yomogi", cursive;
        letter-spacing: -.03em;
      }
      /* ★見出しの下線は水色で統一★ */
      .section-heading h2 span {
        color: var(--wood-dark);
        border-bottom: 3.5px solid var(--water);
        padding-bottom: 2px;
      }
      .section-heading p {
        color: #5d4f43;
        margin: 0;
        font-size: 15px;
      }

      /* ========================================================
         📌 コルクボードカード（木枠＋黒影付き、上部は全面コルク）
         ======================================================== */
      .cork-board {
        position: relative;
        padding: 32px 24px 24px;
        /* 四隅全周を木枠で囲み、上部も黄色ではなくコルク全面を表示 */
        border: var(--wood-frame-border);
        border-radius: 12px 14px 11px 13px;
        box-shadow: 
          inset 0 0 0 2px rgba(255, 235, 205, 0.45), /* 木枠内側の立体ハイライト */
          inset 0 0 16px rgba(45, 25, 10, 0.18),      /* コルク端の自然な陰影 */
          var(--wood-frame-shadow);                 /* 外側の手書き風黒影 */
        background-color: #d8a478; /* コルク画像ロード前の背景色 */
        background-image: 
          linear-gradient(rgba(255, 255, 255, 0.08), rgba(0, 0, 0, 0.04)),
          url('/images/corkboard.jpg');
        background-repeat: repeat;
        background-size: 320px auto;
        transition: transform .2s ease;
      }
      .cork-board:hover {
        transform: translateY(-3px);
      }

      /* コルクボード内の手書きメモ用紙（白・生成りペーパー）風コンテナ */
      .cork-paper {
        background: rgba(255, 253, 248, 0.95);
        border: 2px solid var(--ink);
        border-radius: 6px;
        padding: 20px 20px;
        box-shadow: 3px 3px 0 rgba(43, 34, 26, 0.25);
        position: relative;
      }

      /* ピン留めアイコン（プッシュピン）風のあしらい */
      .cork-board .pin-top {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid var(--ink);
        box-shadow: 1px 2px 3px rgba(0,0,0,0.35);
        z-index: 5;
      }
      .pin-yellow { background: var(--yellow); }
      .pin-red { background: #e05a47; }
      .pin-blue { background: var(--water); }

      /* 住まい別の診断カード (賃貸 vs 戸建て) */
      .choice-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 30px;
      }
      .badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        border: 1.5px solid var(--ink);
        font: 11px "DM Mono", monospace;
        font-weight: 700;
        margin-bottom: 12px;
        background: #fdfaf3;
      }
      .badge span {
        border-bottom: 2px solid var(--water); /* バッジ内の下線も水色 */
      }

      .choice-card h3 {
        font-family: "Yomogi", cursive;
        font-size: 24px;
        margin-bottom: 10px;
      }
      .check-list {
        list-style: none;
        padding: 0;
        margin: 14px 0 20px;
      }
      .check-list li {
        position: relative;
        padding-left: 24px;
        margin-bottom: 8px;
        font-size: 14.5px;
        line-height: 1.7;
      }
      .check-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--leaf);
        font-weight: bold;
        font-size: 17px;
      }

      /* 主力商品ピックアップ（コルクボード風ボックス） */
      .featured-box {
        border: 5px solid var(--wood-frame);
        border-radius: 14px;
        box-shadow: 
          inset 0 0 0 2px rgba(255, 235, 205, 0.4),
          7px 8px 0 var(--ink);
        padding: 34px 28px;
        margin: 40px 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 26px;
        align-items: center;
        position: relative;
        background-color: #d8a478;
        background-image: url('/images/corkboard.jpg');
        background-size: 340px auto;
      }
      .featured-ribbon {
        position: absolute;
        top: -14px;
        left: 24px;
        background: var(--yellow); /* リボンのベースは黄色 */
        border: 2px solid var(--ink);
        padding: 4px 16px;
        border-radius: 4px;
        font: 700 13px "Yomogi", cursive;
        box-shadow: 2px 2px 0 var(--ink);
        transform: rotate(-2deg);
        z-index: 10;
      }
      .featured-inner-paper {
        background: rgba(255, 253, 248, 0.95);
        border: 2px solid var(--ink);
        border-radius: 8px;
        padding: 24px;
        box-shadow: 3px 3px 0 rgba(43, 34, 26, 0.25);
      }
      .product-preview {
        background: #fff;
        border: 3.5px solid var(--wood-frame);
        border-radius: 9px;
        padding: 20px;
        text-align: center;
        box-shadow: 
          inset 0 0 0 1.5px rgba(255, 245, 230, 0.6),
          4px 4px 0 var(--ink);
      }
      .product-mockup {
        width: 100%;
        height: 190px;
        background: #fdfaf3;
        border: 2px dashed #a8947e;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--wood-dark);
        font-family: "Yomogi", cursive;
      }
      .table-responsive {
        width: 100%;
        overflow-x: auto;
      }
      .spec-mini-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 14px;
        font-size: 14px;
      }
      .spec-mini-table th, .spec-mini-table td {
        padding: 7px 10px;
        border-bottom: 1.5px solid #d4c5b2;
        text-align: left;
      }
      .spec-mini-table th {
        color: var(--wood-dark);
        font-weight: 700;
        width: 36%;
        white-space: nowrap;
      }

      /* 3つの確認ステップ（コルクボード調） */
      .steps-wrap {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 24px;
      }
      .step-item {
        padding: 24px 18px 20px;
      }
      .step-num {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--leaf);
        color: #fff;
        display: grid;
        place-items: center;
        font: 700 15px "DM Mono", monospace;
        margin-bottom: 10px;
        border: 1.5px solid var(--ink);
      }
      .step-item h4 {
        margin: 0 0 8px;
        font-size: 18px;
        font-family: "Yomogi", cursive;
        border-bottom: 2px solid var(--water); /* 見出し下線は水色 */
        display: inline-block;
        padding-bottom: 2px;
      }
      .step-item p {
        font-size: 13.5px;
        color: #4f4236;
        margin: 8px 0 0;
        line-height: 1.7;
      }

      /* その他の選択肢カード */
      .choice-sub-card {
        padding: 24px 18px 20px;
      }
      .choice-sub-card h3 {
        border-bottom: 2px solid var(--water); /* 下線は水色 */
        display: inline-block;
        padding-bottom: 2px;
      }

      /* 調査・比較方針カード */
      .policy-box {
        margin-top: 45px;
        background: rgba(255, 252, 245, 0.96);
        border: var(--wood-frame-border);
        border-radius: 12px;
        padding: 28px 24px;
        box-shadow: 
          inset 0 0 0 1.5px rgba(255, 245, 230, 0.6),
          var(--wood-frame-shadow);
      }
      .policy-box h3 {
        margin-top: 0;
        margin-bottom: 12px;
        font-family: "Yomogi", cursive;
        font-size: 22px;
        color: var(--wood-dark);
        border-bottom: 2.5px solid var(--water);
        display: inline-block;
        padding-bottom: 2px;
      }
      .policy-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
        margin-top: 16px;
      }
      .policy-item {
        background: #faf4e8;
        border: 1.5px solid var(--ink);
        border-radius: 8px;
        padding: 16px;
      }
      .policy-item h4 {
        margin: 0 0 6px;
        font-size: 16px;
        font-family: "Yomogi", cursive;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .policy-item p {
        margin: 0;
        font-size: 13.5px;
        color: #4f4236;
        line-height: 1.7;
      }

      /* FAQカード */
      .faq-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 20px;
        margin-top: 24px;
      }
      .faq-card {
        padding: 22px 20px;
      }
      .faq-q {
        font-family: "Yomogi", cursive;
        font-size: 18px;
        font-weight: 700;
        color: var(--wood-dark);
        margin: 0 0 10px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
      }
      .faq-q-mark {
        background: var(--yellow);
        color: var(--ink);
        border: 1.5px solid var(--ink);
        border-radius: 50%;
        width: 26px;
        height: 26px;
        display: grid;
        place-items: center;
        font-size: 14px;
        font-family: "DM Mono", monospace;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 2px;
      }
      .faq-a {
        margin: 0;
        font-size: 14px;
        color: #4a3e33;
        line-height: 1.75;
      }

      /* フッター */
      .site-footer {
        background: rgba(234, 224, 203, 0.9);
        border-top: var(--line);
        margin-top: 65px;
        padding: 35px 0 25px;
      }
      .footer-inner {
        width: min(1160px, calc(100% - 32px));
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
      }
      .footer-inner p {
        font-size: 12.5px;
        color: #635547;
        margin: 0;
      }

      /* スマホ最適化（768px以下） */
      @media (max-width: 768px) {
        body {
          font-size: 15px;
          background-size: 500px auto;
        }
        .site-header {
          min-height: 64px;
        }
        .logo {
          font-size: 16px;
        }
        .logo-mark {
          width: 34px;
          height: 30px;
          font-size: 11px;
        }
        .menu-toggle {
          display: inline-block;
        }
        .main-nav {
          display: none;
          position: absolute;
          top: 64px;
          left: 0;
          right: 0;
          z-index: 100;
          padding: 16px 20px;
          background: #fcf8f0;
          border: var(--line);
          border-radius: 8px;
          box-shadow: 4px 5px 0 var(--ink);
          flex-direction: column;
          gap: 12px;
        }
        .main-nav.is-active {
          display: flex;
        }

        .hero {
          grid-template-columns: 1fr;
          padding: 24px 0 32px;
          gap: 24px;
          min-height: auto;
        }
        h1 {
          font-size: 29px;
          line-height: 1.35;
          margin-bottom: 14px;
        }
        .hero-text {
          font-size: 14px;
          margin-bottom: 20px;
